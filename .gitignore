# --- 客户端 ---
client/node_modules/
client/dist/
client/out/
client/*.log
# --- 服务端 ---
server/wangpan-server
server/bin/
server/*.exe
server/.env
server/data/
# --- 本地工具链与缓存（start 脚本可用，不提交） ---
.tools/
# --- 客户端便携运行数据 ---
.runtime/
# --- 运行期产物 ---
*.wpdl.json
*.part
tasks.json
sync-index.json
# --- 运行日志（含本机绝对路径、上传文件名等，禁止提交）---
logs/
*.log

# --- 随包构建产物：由 client/scripts/bundle-server.js 从 server/bin 复制生成，不提交 ---
client/resources/server/

# --- 环境变量（仅提交 .env.example 模板）---
.env
.env.*
!.env.example

# --- 系统杂项 ---
.DS_Store
Thumbs.db
*.tmp
# --- 编辑器 ---
.vscode/
.idea/
