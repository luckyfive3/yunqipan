@echo off
rem =====================================================
rem  云栖盘 兼容启动器（安装版）
rem  部分机器（含开发机）的 Chromium 需 --no-sandbox 参数才能启动，
rem  直接双击 云栖盘.exe 会静默退出。正常机器可任意方式启动。
rem  双击本文件即可；用户数据默认在 %APPDATA%\云栖盘。
rem =====================================================
setlocal
chcp 65001 >nul
set "DIR=%~dp0"
echo [云栖盘] 启动客户端（兼容模式）...
start "" "%DIR%云栖盘.exe" --no-sandbox
