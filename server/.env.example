# 云栖盘服务端环境变量示例。
# 开发默认值已与 docker-compose.dev.yml 对齐，可零配置直接 go run ./cmd/server；
# 生产环境必须修改 JWT_SECRET / PREVIEW_TOKEN_SECRET / MINIO_SECRET_KEY 为强随机值。

# HTTP 监听地址
SERVER_ADDR=:8080

# PostgreSQL
DATABASE_URL=postgres://wangpan:wangpan@localhost:5432/wangpan?sslmode=disable

# Redis（可选：留空则登录限流/缓存自动降级为 no-op）
REDIS_URL=redis://localhost:6379/0

# S3 兼容对象存储（Path-Style；开发用 adobe/s3mock 容器，端口见 docker-compose.dev.yml）
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wangpan
MINIO_USE_SSL=false

# 安全密钥（生产：openssl rand -hex 32 生成两个不同值）
JWT_SECRET=dev-insecure-jwt-secret-change-me
PREVIEW_TOKEN_SECRET=dev-insecure-preview-secret-change-me

# 新用户默认配额（GB），0 = 不限容量
DEFAULT_QUOTA_GB=10

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 客户端展示分享链接时使用的基础地址（服务端不读取，仅供客户端/文档参考）
SHARE_BASE_URL=http://127.0.0.1:8080

# ── 单机模式（可选）：LOCAL_MODE=1 时使用 SQLite + 本地磁盘，无需 PostgreSQL/MinIO/Docker ──
# LOCAL_MODE=1
# DATA_DIR=./data-local
